# --- Required ---------------------------------------------------------------

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...


# --- CRM selection ----------------------------------------------------------

# "mock"        -> in-memory fake CRM. No accounts needed. Use this to develop
#                  and demo the whole booking flow locally.
# "gohighlevel" -> live GoHighLevel v2 API. Requires the three vars below.
CRM_ADAPTER=mock


# --- GoHighLevel (only needed when CRM_ADAPTER=gohighlevel) ------------------
# See docs/GHL-SETUP.md for how to obtain these.

# Private Integration token from your GHL sub-account
# (Settings -> Private Integrations -> Create). Starts with "pit-".
GHL_TOKEN=

# Your sub-account (location) ID. Visible in the GHL URL when inside the
# sub-account: app.gohighlevel.com/v2/location/<THIS_PART>/
GHL_LOCATION_ID=

# Optional: the GHL user (staff member) appointments get assigned to.
GHL_ASSIGNED_USER_ID=


# --- Server -----------------------------------------------------------------

PORT=3000

# Set to "production" to disable the /api/debug/* routes.
NODE_ENV=development
